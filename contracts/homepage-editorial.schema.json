{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sia-infinity.com/contracts/homepage-editorial.schema.json",
  "title": "SIA Homepage Editorial Authority",
  "type": "object",
  "required": ["eligible", "excluded", "placement", "excluded_category_ids"],
  "properties": {
    "eligible": {"type": "boolean"},
    "excluded": {"type": "boolean"},
    "placement": {
      "enum": ["normal", "lead", "top", "breaking", "section_featured"]
    },
    "excluded_category_ids": {
      "type": "array",
      "items": {"type": "integer", "minimum": 1},
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
